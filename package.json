{
  "name": "pi-clawbay",
  "version": "0.2.1",
  "description": "TheClawBay provider extension for Pi Coding Agent - access GPT-5 and Codex models",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc",
    "check": "tsc --noEmit",
    "prepare": "npm run build",
    "test": "npm run build && node test/extension.test.mjs"
  },
  "pi": {
    "extensions": [
      "dist/index.js"
    ]
  },
  "keywords": [
    "pi",
    "pi-coding-agent",
    "theclawbay",
    "gpt-5",
    "codex",
    "ai",
    "llm",
    "provider"
  ],
  "author": "Chris Lopez",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chrislopez24/pi-clawbay.git"
  },
  "bugs": {
    "url": "https://github.com/chrislopez24/pi-clawbay/issues"
  },
  "homepage": "https://github.com/chrislopez24/pi-clawbay#readme",
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.74.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.74.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.74.0"
  }
}
